# ── Email delivery (choose one or more — first working one is used) ──

# Option A: Resend (recommended for production — free 100 emails/day)
# Sign up at https://resend.com → API Keys → Create key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Formspree (simplest — free 50/month, no credit card)
# Sign up at https://formspree.io → New Form → copy the ID from the URL
