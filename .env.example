# Option C: Web3Forms (free 250/month)
# Sign up at https://web3forms.com → Create Form → copy Access Key
WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Admin password ──
ADMIN_PASSWORD=changeme

# ── Site URL (used for OG tags) ──
